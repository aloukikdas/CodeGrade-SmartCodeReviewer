@model IEnumerable<CodeReviewer.Mvc.Models.ClassroomViewModel>
@{
    ViewData["Title"] = "My Classrooms";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold"><i class="bi bi-backpack me-2"></i>Enrolled Classes</h2>
            <p class="text-muted">Join a classroom using the 6-character code provided by your teacher.</p>
        </div>
        <div class="col-md-4">
            <!-- Join Classroom Form -->
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <form asp-action="Join" method="post" class="d-flex gap-2">
                        <input type="text" name="JoinCode" class="form-control font-monospace text-uppercase" placeholder="6-DIGIT CODE" maxlength="6" required />
                        <button type="submit" class="btn btn-success fw-bold">Join</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrolled Classes Grid -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center mt-5 text-muted">
                <i class="bi bi-door-closed fs-1"></i>
                <p class="mt-2">You are not enrolled in any classes yet.</p>
            </div>
        }
        else
        {
            @foreach (var classroom in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 border-start border-success border-4 h-100 rounded-3">
                        <div class="card-body">
                            <h4 class="card-title fw-bold">@classroom.Name</h4>
                            <p class="text-muted small">Teacher ID: @classroom.TeacherId</p>
                            <a asp-controller="Student" asp-action="Assignments" asp-route-classroomId="@classroom.Id" class="btn btn-outline-success btn-sm w-100 mt-2">
                                Go to Assignments <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>