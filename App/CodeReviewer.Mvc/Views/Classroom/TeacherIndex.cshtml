@model IEnumerable<CodeReviewer.Mvc.Models.ClassroomViewModel>
@{
    ViewData["Title"] = "Manage Classrooms";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold"><i class="bi bi-building me-2"></i>My Classrooms</h2>
            <p class="text-muted">Create classrooms and share the 6-character Join Code with your students.</p>
        </div>
        <div class="col-md-4">
            <!-- Create Classroom Form -->
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <form asp-action="Create" method="post" class="d-flex gap-2">
                        <input type="text" name="Name" class="form-control" placeholder="E.g., CS101 Fall" required />
                        <button type="submit" class="btn btn-primary fw-bold">Create</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Classrooms Grid -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center mt-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">You haven't created any classrooms yet.</p>
            </div>
        }
        else
        {
            @foreach (var classroom in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100 rounded-3">
                        <div class="card-body">
                            <h4 class="card-title fw-bold">@classroom.Name</h4>
                            <hr />
                            <p class="text-muted mb-1">Student Join Code:</p>
                            <div class="d-flex align-items-center justify-content-between bg-dark rounded p-2 text-white">
                                <span class="fs-4 fw-bold font-monospace tracking-widest ms-2">@classroom.JoinCode</span>
                                <button class="btn btn-sm btn-outline-light" onclick="navigator.clipboard.writeText('@classroom.JoinCode')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Classroom" asp-action="TeacherAssignments" asp-route-classroomId="@classroom.Id" class="btn btn-outline-primary btn-sm w-100">
                                    Manage Assignments <i class="bi bi-arrow-right"></i>
                                </a>
                                <a asp-controller="Teacher" asp-action="ClassroomSubmissions" asp-route-classroomId="@classroom.Id" class="btn btn-outline-info btn-sm w-100 mt-2">
                                    View Submissions <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Teacher" asp-action="EnrolledStudents" asp-route-classroomId="@classroom.Id" class="btn btn-outline-secondary btn-sm w-100 mt-2">
                                    View Students <i class="bi bi-people"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>