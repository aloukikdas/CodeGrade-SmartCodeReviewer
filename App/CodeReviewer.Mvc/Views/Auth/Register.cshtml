@model CodeReviewer.Mvc.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-dark text-white p-3 text-center">
                <h4 class="mb-0">Create an Account</h4>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Create a password" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">I am a:</label>
                        <select asp-for="Role" class="form-select">
                            <option value="">-- Select Role --</option>
                            <option value="Student">Student</option>
                            <option value="Teacher">Faculty / Teacher</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Register Account</button>
                </form>
                <div class="mt-3 text-center">
                    <p>Already have an account? <a asp-action="Login">Log in here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>