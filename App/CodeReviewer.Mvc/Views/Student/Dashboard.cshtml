@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <div class="mb-4">
                <i class="bi bi-mortarboard text-success" style="font-size: 5rem;"></i>
            </div>

            <h1 class="fw-bold mb-3">Welcome to the Student Portal!</h1>
            <figure class="text-center mb-4 mt-4 px-4">
                <blockquote class="blockquote fs-4 fst-italic text-muted">
                    <p>"Any fool can write code that a computer can understand. Good programmers write code that humans can understand."</p>
                </blockquote>
                <figcaption class="blockquote-footer mt-2 fs-6">
                    Martin Fowler
                </figcaption>
            </figure>

            <hr class="w-50 mx-auto mb-4" />

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Classroom" asp-action="StudentIndex" class="btn btn-success btn-lg shadow-sm">
                    <i class="bi bi-backpack me-2"></i> View My Classrooms
                </a>
            </div>

        </div>
    </div>
</div>