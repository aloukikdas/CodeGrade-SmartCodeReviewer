@model IEnumerable<CodeReviewer.Mvc.Models.AssignmentViewModel>
@{
    ViewData["Title"] = "Class Assignments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-card-checklist me-2"></i>Class Assignments</h2>
        <a asp-controller="Classroom" asp-action="StudentIndex" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Classrooms
        </a>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center mt-5 text-muted">
                <i class="bi bi-emoji-smile fs-1"></i>
                <p class="mt-2">No assignments have been posted for this class yet!</p>
            </div>
        }
        else
        {
            @foreach (var assignment in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 border-top border-primary border-4 h-100">
                        <div class="card-body">
                            <h4 class="card-title fw-bold">@assignment.Title</h4>
                            <p class="text-muted" style="white-space: pre-wrap;">@assignment.Description</p>
                            <div class="mt-3 d-flex align-items-center justify-content-between">
                                <span class="badge bg-secondary">Language: @(assignment.AllowedLanguage == "Any" ? "Any Language" : assignment.AllowedLanguage.ToUpper())</span>

                                @if (assignment.HasSubmitted)
                                {
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-secondary disabled">
                                            <i class="bi bi-lock-fill"></i> Submitted (Locked)
                                        </button>

                                        @if (assignment.HasGrade)
                                        {
                                            <a asp-action="ViewSubmission" asp-route-id="@assignment.SubmissionId" class="btn btn-outline-primary">
                                                <i class="bi bi-robot"></i> View Feedback
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary" onclick="showAiThinking()">
                                                <i class="bi bi-robot"></i> View Feedback
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Student" asp-action="Index" asp-route-assignmentId="@assignment.Id" class="btn btn-primary">
                                        <i class="bi bi-code-slash me-1"></i> Open Code Editor
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Handle the "Code Submitted" Success Pop-up -->
    @if (TempData["SweetSuccess"] != null)
    {
        <script>
            Swal.fire({
            title: 'Awesome Work!',
            text: '@TempData["SweetSuccess"]',
            icon: 'success',
            timer: 2500,
            showConfirmButton: false,
            backdrop: `rgba(0,0,0,0.4)`
            });
        </script>
    }

    <!-- Handle the "AI is Thinking" Animation -->
    <script>
        function showAiThinking() {
        Swal.fire({
        title: 'AI is Analyzing!',
        text: 'Your code is currently being evaluated by our AI instructor. Give it just a few moments to finish running the tests!',
        iconHtml: '<div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>',
        customClass: {
        icon: 'border-0'
        },
        showConfirmButton: false,
        timer: 4500,
        timerProgressBar: true,
        backdrop: `rgba(0,0,123,0.4)`
        });
        }
    </script>
}